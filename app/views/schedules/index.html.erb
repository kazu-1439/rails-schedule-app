<h1>予定一覧</h1>

<p>予定数: <%= @schedules.count %></p>
<p>本日: <%= Date.today.strftime("%Y/%m/%d") %></p>

<table border="1">
  <tr>
    <th>ID</th>
    <th>タイトル</th>
    <th>開始日</th>
    <th>終了日</th>
    <th>終日</th>
    <th>更新日時</th>
    <th></th>
  </tr>

<% @schedules.each do |schedule| %>
  <tr>
    <td><%= schedule.id %></td>
    <td><%= schedule.title %></td>
    <td><%= schedule.start_date.strftime("%Y/%m/%d") %></td>
    <td><%= schedule.end_date.strftime("%Y/%m/%d") %></td>
    <td><%= schedule.all_day ? "○" : "" %></td>
    <td><%= schedule.updated_at.strftime("%Y/%m/%d %H:%M") %></td>

    <td>
      <%= link_to "詳細", schedule %>
      <%= link_to "編集", edit_schedule_path(schedule) %>
      <%= link_to "削除", schedule, method: :delete, data: { confirm: "予定を削除しますか？" } %>
    </td>
  </tr>
<% end %>

</table>

<br>

<%= link_to "予定を新規追加", new_schedule_path %>

